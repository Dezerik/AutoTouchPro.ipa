name: AutoTouchPro

options:
  bundleIdPrefix: com.autotouchpro

targets:
  AutoTouchPro:
    type: application
    platform: iOS
    deploymentTarget: "16.0"
    sources:
      - path: .
        includes:
          - "*.swift"
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.autotouchpro.app
        SWIFT_VERSION: "5.0"
        TARGETED_DEVICE_FAMILY: "2"
        INFOPLIST_KEY_UIApplicationSceneManifest_Generation: YES
        GENERATE_INFOPLIST_FILE: YES
